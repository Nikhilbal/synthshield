
FROM python:3.13-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

RUN pip install --no-cache-dir \
    "fastapi>=0.115,<1" \
    "uvicorn>=0.30,<1" \
    "psycopg[binary]>=3.2,<4" \
    "python-dotenv>=1,<2"

COPY src/ /app/src/
COPY data/ /app/data/

RUN mkdir -p /app/audit_logs
